APP_NAME=Forecast IQ API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# Pipeline Orchestration & Execution Layer. One of:
#   local          runs forecast_engine as a local subprocess.
#   databricks     submits to the Databricks Serverless job (primary cloud path).
#   databricks_dcs submits to the Databricks Container Services (ACR/Docker) job.
# Leave as local for local development. See docs/execution-modes.md.
EXECUTION_MODE=local

# Path to the standalone forecast_engine package, relative to wherever this
# backend process is started from (normally backend/). Leave as the
# default unless your checkout layout differs.
FORECAST_ENGINE_ROOT=../forecast_engine
# Only set this if you need to point at a forecast_engine interpreter in a
# non-default location; leave blank to use FORECAST_ENGINE_ROOT/.venv/bin/python.
FORECAST_ENGINE_PYTHON=
JOB_TIMEOUT_SECONDS=3600
JOB_POLL_INTERVAL_SECONDS=2

# --- LLM Business Insights (Section 6.12) — Azure OpenAI only ---
# Optional for local development: leave all four blank and the pipeline
# still runs end to end, it just skips generating the business-insight
# narrative (reported as "unavailable", not an error).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
# How many groups may have an insight call in flight at once. Blank uses the
# engine's default (8). Lower it if the Azure OpenAI deployment's
# tokens-per-minute quota cannot absorb that much concurrency.
LLM_INSIGHT_MAX_WORKERS=

# --- MLflow Experiment Tracking & Model Registry (Section 6.13) ---
# Optional for local development: leave all four blank and MLflow tracks
# locally by default (sqlite:///mlflow.db + ./mlruns/, created automatically
# inside forecast_engine/ on first run). Set these only to point at a
# remote/shared tracking server (e.g. Databricks later).
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_NAME=
MLFLOW_ARTIFACT_LOCATION=

# --- Entra ID authentication + RBAC ---
# Leave AUTH_ENABLED=false for local development and the API issues a local
# development identity with the DEV_IDENTITY_ROLE below, so the app runs with
# no Azure tenant at all. The API REFUSES TO START with this false unless
# APP_ENV is development/local/test, so it cannot ship unauthenticated.
AUTH_ENABLED=false
# Admin | DataScientist | Analyst — handy for exercising RBAC locally.
DEV_IDENTITY_ROLE=Admin

# Required when AUTH_ENABLED=true. See docs/PHASE_A_AZURE_SETUP.md for the
# app registrations these come from. None of these is a secret: the API
# validates tokens with the tenant's PUBLIC signing keys and holds no Entra
# credential of its own.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_SPA_CLIENT_ID=
# Only for a sovereign/government cloud.
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Fallback when access is granted by security group rather than app role:
# ENTRA_GROUP_ROLE_MAP={"<group-object-id>":"Analyst"}
ENTRA_GROUP_ROLE_MAP=

# --- Databricks execution (read when EXECUTION_MODE=databricks or databricks_dcs) ---
# The same service principal authenticates both cloud modes — Serverless and
# DCS are two Job resources in one workspace, not two credentials.
# Prefer the service principal over DATABRICKS_TOKEN: it is workspace-scoped,
# rotatable, and belongs to no individual person.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_ID=
# UC external volume for ORIGINAL uploaded datasets only — nothing else
# is ever stored here.
DATABRICKS_UPLOADS_VOLUMES_ROOT=/Volumes/forecastiq/forecasting/forecast_files
# Databricks secret scope holding the engine's Azure OpenAI credentials, as
# keys `azure-openai-endpoint`, `azure-openai-api-key` and
# `azure-openai-deployment`.
#
# Only this NAME is sent to Databricks, as a task parameter. The engine reads
# the values itself on the cluster with dbutils, so the backend never handles
# a credential and both compute modes resolve them the same way — a task
# parameter reaches an existing cluster, a cluster env var does not.
#
# Blank means Databricks runs fall back to template insights. The
# AZURE_OPENAI_* values below are for LOCAL runs only.
DATABRICKS_SECRET_SCOPE=forecastiq

# Where the deployed forecast_engine wheel lives, for a job cluster to
# install. Point this at the bundle's artifact DIRECTORY, not a filename:
# CI stamps each build with its own version, so the filename changes every
# deploy. A directory (or a filename a later deploy replaced) resolves to
# whatever is deployed there now. Blank means the cluster already has the
# engine, which is how Existing Compute may be set up.
DATABRICKS_ENGINE_WHEEL_PATH=

# --- Cost estimation ---
# Blended hourly rate for the compute a run occupies. Leave blank and the
# estimate shows duration only — a fabricated cost figure is worse than none.
COMPUTE_COST_PER_HOUR=
COMPUTE_COST_CURRENCY=USD

AZURE_STORAGE_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
