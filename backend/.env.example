APP_NAME=Forecast IQ API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# Pipeline Orchestration & Execution Layer. "local" runs forecast_engine as
# a local subprocess; "databricks" is architecture-only today (no real
# Databricks calls are made). Leave as local for local development.
EXECUTION_MODE=local

# Path to the standalone forecast_engine package, relative to wherever this
# backend process is started from (normally backend/). Leave as the
# default unless your checkout layout differs.
FORECAST_ENGINE_ROOT=../forecast_engine
# Only set this if you need to point at a forecast_engine interpreter in a
# non-default location; leave blank to use FORECAST_ENGINE_ROOT/.venv/bin/python.
FORECAST_ENGINE_PYTHON=
JOB_TIMEOUT_SECONDS=3600
JOB_POLL_INTERVAL_SECONDS=2

# --- LLM Business Insights (Section 6.12) — Azure OpenAI only ---
# Optional for local development: leave all four blank and the pipeline
# still runs end to end, it just skips generating the business-insight
# narrative (reported as "unavailable", not an error).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# --- MLflow Experiment Tracking & Model Registry (Section 6.13) ---
# Optional for local development: leave all four blank and MLflow tracks
# locally by default (sqlite:///mlflow.db + ./mlruns/, created automatically
# inside forecast_engine/ on first run). Set these only to point at a
# remote/shared tracking server (e.g. Databricks later).
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_NAME=
MLFLOW_ARTIFACT_LOCATION=

# --- Reserved for the Azure deployment phase — not implemented yet ---
# Nothing reads these today; DatabricksRunner is a placeholder
# (app/orchestration/databricks_runner.py) until that phase is built.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_ID=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
