# Databricks Asset Bundle — environment configuration.
#
# These values identify your Azure tenant, so they are supplied per machine /
# per CI environment rather than committed. Copy to `.env` and fill in:
#
#     cp .env.example .env && source .env
#
# `.env` is gitignored. In CI the same names come from GitHub Actions secrets,
# so nothing about the bundle differs between a laptop and a pipeline.

# --- Local development -------------------------------------------------------
# The workspace URL lives in ~/.databrickscfg (never committed), and this names
# which profile to use. Create one with:
#     databricks auth login --host https://adb-xxxx.N.azuredatabricks.net \
#         --profile my-workspace
export DATABRICKS_CONFIG_PROFILE=my-workspace

# --- CI (no ~/.databrickscfg available) --------------------------------------
# Use these instead of the profile above. Set both, not just the host: the host
# alone loses to `default_profile` in any config file that happens to exist.
# export DATABRICKS_HOST=https://adb-xxxxxxxxxxxxxxxx.N.azuredatabricks.net
# export DATABRICKS_CLIENT_ID=<service principal application id>
# export DATABRICKS_CLIENT_SECRET=<service principal oauth secret>

# --- Bundle variables --------------------------------------------------------
# Any variable declared in databricks.yml can be set as BUNDLE_VAR_<name>.
export BUNDLE_VAR_acr_image=myregistry.azurecr.io/forecast-engine
export BUNDLE_VAR_acr_image_tag=0.1.1

# Optional — only when this deployment differs from databricks.yml's defaults.
# export BUNDLE_VAR_catalog=forecastiq
# export BUNDLE_VAR_schema=forecasting
# export BUNDLE_VAR_volume=forecast_files
# export BUNDLE_VAR_node_type_id=Standard_D8s_v5
