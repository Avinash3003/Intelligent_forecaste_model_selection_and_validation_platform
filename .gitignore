# Dependencies
node_modules/

# Build output
dist/
build/
*.egg-info/

# Environment variables — real values never leave the machine.
# The `!` lines re-admit the templates, which carry key names but no values;
# without them `.env.*` would also exclude the examples other developers need.
.env
.env.*
!.env.example
!**/.env.example
*.local

# Editor / IDE
.vscode/
.idea/

# Python
.venv/
venv/
__pycache__/
*.pyc

# Logs
logs/
*.log
lightning_logs/

# Test coverage
coverage/

# Local/sample data
dummy_data/
sample_data/
test_data/

# Run output produced by the Forecast Engine — regenerated by any run, and
# large. None of it is source.
curated/
models/
forecasts/
artifacts/
mlruns/
mlflow.db
uploads/

# LLM evaluation reports — generated by `python -m forecast_engine.s11_llm.
# evaluate`, regenerated by every run. The dataset the reports are scored
# against (forecast_engine/s11_llm/eval_dataset/) is source and stays
# tracked; only the run output here is not.
forecast_engine/s11_llm/eval_output/

# Source datasets. Kept out deliberately: they are tens of MB, are not source,
# and may carry business data that does not belong in a shared repository.
# Contributors stage their own via the upload flow or the UC volume.
*.csv
*.parquet
*.xlsx
*.xls

# Databricks Asset Bundle local state — contains per-user workspace paths and
# deployment locks, so it is machine-specific rather than shared.
.databricks/
**/.databricks/

# Reference documents — never commit
docs/
*.pdf
*.doc
*.docx

# Pytest scratch (tests/conftest.py points UPLOAD_DIR here)
.pytest-uploads/
.pytest_cache/

# Claude Code runtime state (scheduled task locks, etc.)
.claude/
