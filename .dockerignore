# Build context for Dockerfile at repo root. The Dockerfile only ever
# COPYs forecast_engine/requirements.txt explicitly, so nothing below is
# at risk of landing in the image either way — this file exists to keep
# the context Docker uploads to the daemon small and fast, and as an
# explicit, auditable statement of what must never be sent.

# Never ship application code into a dependencies-only image.
backend/
frontend/
forecast_engine/**/*.py
!forecast_engine/requirements.txt

# Never ship secrets.
.env
**/.env
*.env
**/*.pem
**/*.key

# Local run artifacts — large, and specific to this machine.
forecast_engine/.venv/
**/.venv/
**/__pycache__/
**/*.pyc
mlflow.db
mlruns/
curated/
node_modules/
dist/
build/
*.egg-info/

# VCS / editor / OS noise.
.git/
.gitignore
.vscode/
.idea/
.DS_Store
